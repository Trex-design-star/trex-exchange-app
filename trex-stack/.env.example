# Copy to api/.env and web/.env.local and fill in (never commit real keys)
DATABASE_URL=postgresql://trex:trex@localhost:5432/trex
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Email (Resend) — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
MAIL_FROM=Trex <no-reply@yourdomain.com>
# Money in/out (Paystack) — get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxx
# File storage (Cloudflare R2, S3-compatible) — dashboard: R2 > Manage R2 API tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=trex-proofs
